package pages

import (
    "github.com/vulan1999/go-todo-list/internal/model"
    "github.com/vulan1999/go-todo-list/views/layouts"
)

templ Home(todos []model.Todo){
    @layouts.Base("Home - Todo List"){
        <section>
            <h2>My Todo List</h2>

            <form>
                <input
                    type="text"
                    name="title"
                    placeholder="Enter a new task..."
                />
                <button type="submit">Add Task</button>
            </form>

            <ul>
                for _, todo := range todos{
                    if todo.Done {
                        <li><s>{todo.Title}</s></li>
                    } else {
                        <li>{ todo.Title }</li>
                    }
                } 
            </ul>
        </section>
    }
    
}
