package layouts

templ Base(title string) {
    <!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
		</head>
		<body>
			<header>
				<h1>Todo List</h1>
			</header>

			<main>
				{ children... }
			</main>

            <script src="/static/js/htmx.min.js"></script>

			<footer>
				<p>Todo List App</p>
			</footer>
		</body>
	</html>
}
